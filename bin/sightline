#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET"
  fi
done

ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
export SIGHTLINE_ROOT="$ROOT_DIR"
export MSHOT_AGENT_ROOT="$ROOT_DIR"

if [[ -f "$ROOT_DIR/dist/sightline.js" ]]; then
  exec bun "$ROOT_DIR/dist/sightline.js" "$@"
fi

exec bun "$ROOT_DIR/src/cli.ts" "$@"
